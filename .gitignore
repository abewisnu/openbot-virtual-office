# Dependencies
node_modules/

# Build output — rebuild with `npm run build`, never commit it
dist/
*.tsbuildinfo

# Local environment and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Logs and runtime state
*.log
logs/
*.pid

# SQLite databases and their journal files — real OpenBot data never ships
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# Trae IDE share artifacts — generated locally, never part of the project
.trae-html-share-packages/

# Test / tool caches
coverage/
.vite/
.cache/
.eslintcache
screenshots/

# OS and editor cruft
.DS_Store
._*
.AppleDouble/
.Spotlight-V100/
.Trashes/
Thumbs.db
*~
.idea/
.vscode/
