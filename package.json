{
  "name": "openbot-virtual-office",
  "private": true,
  "version": "1.0.0",
  "description": "2D pixel-art virtual office that visualizes live OpenBot agents from a read-only SQLite snapshot.",
  "license": "MIT",
  "author": "Abe Wisnu <abewisnu@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abewisnu/openbot-virtual-office.git"
  },
  "homepage": "https://abewisnu.github.io/openbot-virtual-office/",
  "bugs": {
    "url": "https://github.com/abewisnu/openbot-virtual-office/issues"
  },
  "keywords": [
    "openbot",
    "pixel-art",
    "pixi.js",
    "virtual-office",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
